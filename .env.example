# Flask Secret Key (generate a random string for production)
SECRET_KEY=your-secret-key-here

# Google Gemini API Key (for AI validation)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model used for question generation and answer grading.
# The free tier meters each model separately, so pointing this at another model
# is the way out of a "quota exceeded" error without changing any code.
GEMINI_MODEL=models/gemini-2.5-flash

# Database URL (SQLite by default, no installation needed)
DATABASE_URL=sqlite:///grading_system.db

# Threading settings
MAX_WORKERS=4

# Similarity threshold for material matching
SIMILARITY_THRESHOLD=0.3

# Shared access code required to register a teacher account.
# Leave empty to disable teacher self-registration entirely.
TEACHER_SIGNUP_CODE=change-me

# Minutes of inactivity before a signed-in user is logged out
SESSION_TIMEOUT_MINUTES=30
